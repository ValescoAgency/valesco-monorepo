{
  "name": "valesco-monorepo",
  "version": "1.0.0",
  "description": "Multi-client monorepo with shared packages and Vercel deployment",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@valesco/eslint-config": "workspace:*",
    "@valesco/typescript-config": "workspace:*",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.6",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "monorepo",
    "nextjs",
    "vercel",
    "typescript",
    "tailwind"
  ],
  "author": "Valesco Team",
  "license": "MIT"
}
